# Demo is the safe default. In demo, only synthetic browser-local data is editable.
APP_MODE=demo
# Oracle mode: configure all values, never commit .env. Distinct random tokens >=32 chars.
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_USER=RCONF_APP
ORACLE_PASSWORD=
API_TOKEN_ANALISTA=
API_TOKEN_GESTOR=
API_TOKEN_AUDITOR=
# TCPS and an Oracle wallet are recommended for connections across hosts.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
